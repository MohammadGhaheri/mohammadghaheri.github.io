---
layout: null
permalink: /sitemap.xml
---
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ '/' | absolute_url }}" />
    <xhtml:link rel="alternate" hreflang="fa" href="{{ '/fa/' | absolute_url }}" />
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ '/' | absolute_url }}" />
  </url>
  <url>
    <loc>{{ '/fa/' | absolute_url }}</loc>
    <xhtml:link rel="alternate" hreflang="fa" href="{{ '/fa/' | absolute_url }}" />
    <xhtml:link rel="alternate" hreflang="en" href="{{ '/' | absolute_url }}" />
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ '/' | absolute_url }}" />
  </url>

  {% assign main_pages = "/en/about/,/fa/about/,/en/articles/,/fa/articles/" | split: "," %}
  {% for page_url in main_pages %}
  <url>
    <loc>{{ page_url | absolute_url }}</loc>
  </url>
  {% endfor %}

  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    {% if post.alt_url %}
    <xhtml:link rel="alternate" hreflang="{{ post.lang }}" href="{{ post.url | absolute_url }}" />
    <xhtml:link rel="alternate" hreflang="{% if post.lang == 'fa' %}en{% else %}fa{% endif %}" href="{{ post.alt_url | absolute_url }}" />
    {% endif %}
  </url>
  {% endfor %}
</urlset>
